{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tesla-client-decode-poc",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "workers_dev": false,
  "preview_urls": false,
  // SPA + /videos/*.mp4 + /packs/** are all Workers Static Assets (built into ./dist by build.sh).
  // Only /api/* (logs) and /videos/* (byte-range 206 support) run Worker code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/videos/*"]
  },
  // Custom Domain: Cloudflare creates the DNS record + edge cert for this hostname only.
  "routes": [
    { "pattern": "<your-deployment>", "custom_domain": true }
  ],
  // Workers Logs: every console.log from /api/logs is queryable in the dashboard
  // (Workers & Pages → tesla-client-decode-poc → Observability → Logs) and via `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
