# Copy to .deploy.env.local (gitignored) and fill in. Real env vars and
# ./deploy.sh flags override these. Never commit the filled-in copy.

# --- Both targets ---
# Optional remote debug logs. 0 (default) = playback only: AWS deploys just
# S3 + CloudFront, and the page never POSTs to /api/logs (logs stay in the
# browser console / Debug panel). 1 = page posts debug logs to /api/logs
# (AWS: + HTTP API + Lambda + CloudWatch log group; Cloudflare: Workers Logs).
ENABLE_LOGS=0

# --- Cloudflare target ---
# CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>   # optional with `wrangler login`
WORKER_NAME=tesla-client-decode-poc
# CUSTOM_DOMAIN=poc.example.com                        # optional; unset = workers.dev

# --- AWS target ---
# AWS_PROFILE=<your-profile>
# AWS_REGION=us-east-1
# STACK_NAME=tesla-browser-client-decode-poc
# LOG_GROUP_NAME=/tesla-browser-client-decode-poc/browser
# BUCKET_PREFIX=<optional-prefix>
# EXPECTED_AWS_ACCOUNT=<12-digit-account-id>          # optional guard
